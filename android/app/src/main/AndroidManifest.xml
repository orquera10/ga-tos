<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gastos"
        android:usesCleartextTraffic="true">

        <!-- Pantalla principal: Web viewer -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Gastos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Diálogo para cambiar el presupuesto que se muestra en el Widget -->
        <activity
            android:name=".SelectBudgetActivity"
            android:exported="false"
            android:theme="@style/Theme.Gastos.Dialog"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:excludeFromRecents="true" />

        <!-- Diálogo flotante rápido para cargar gasto desde el Widget -->
        <activity
            android:name=".QuickExpenseActivity"
            android:exported="false"
            android:theme="@style/Theme.Gastos.Dialog"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:excludeFromRecents="true" />

        <!-- Diálogo flotante rápido para cargar ingreso desde el Widget -->
        <activity
            android:name=".QuickIncomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Gastos.Dialog"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:excludeFromRecents="true" />

        <!-- Receptor del Widget de escritorio -->
        <receiver
            android:name=".GastosWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.dario.gastos.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/gastos_widget_info" />
        </receiver>

    </application>

</manifest>
