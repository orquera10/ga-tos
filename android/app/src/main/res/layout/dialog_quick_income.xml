<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="22dp">

    <!-- Top Handle Bar like Figma Bottom Sheet -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#3A3D49" />

    <!-- Header with Figma Green Icon Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_icon_green_bg"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_down"
                android:contentDescription="Ingreso" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CARGA RÁPIDA · WIDGET"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrar ingreso"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ Quedará marcado en la app para que completes cuenta o detalle luego."
        android:textColor="#F0BD62"
        android:textSize="11sp"
        android:layout_marginBottom="16dp" />

    <!-- Monto Input styled like Figma .amount-input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monto"
        android:textColor="#D5D6E2"
        android:textStyle="bold"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_bg"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="13dp">

        <TextView
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@drawable/amount_prefix_bg"
            android:text="$"
            android:textColor="#A99FFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMontoIngreso"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:hint="0"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:paddingHorizontal="14dp" />

    </LinearLayout>

    <!-- Concepto Opcional -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Concepto (opcional)"
        android:textColor="#D5D6E2"
        android:textStyle="bold"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etNombreIngreso"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:inputType="textCapSentences"
        android:hint="Ej. Sueldo, Venta (vacío = ⚡ Ingreso rápido)"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13.5sp"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="13dp" />

    <!-- Presupuesto Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Presupuesto en foco"
        android:textColor="#D5D6E2"
        android:textStyle="bold"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spPresupuestoIngreso"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/input_bg"
        android:popupBackground="#151821"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelIngreso"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#D5D6E2"
            android:textStyle="bold"
            app:backgroundTint="#242731"
            app:cornerRadius="13dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveIngreso"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.35"
            android:text="Guardar ingreso"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="@color/success"
            app:cornerRadius="13dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</LinearLayout>
