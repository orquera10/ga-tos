<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuevo Ingreso"
        android:textColor="@color/primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Monto Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monto ($)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etMontoIngreso"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:inputType="numberDecimal"
        android:hint="0.00"
        android:textColor="#FFFFFF"
        android:textColorHint="@color/text_muted"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Concepto -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Concepto"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etNombreIngreso"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:inputType="textCapSentences"
        android:hint="Ej: Cobro de honorarios, Sueldo..."
        android:textColor="#FFFFFF"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Presupuesto Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Presupuesto a acreditar"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spPresupuestoIngreso"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/input_bg"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelIngreso"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Cancelar"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_secondary"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaveIngreso"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Guardar Ingreso"
            android:textColor="#000000"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="20dp" />

    </LinearLayout>

</LinearLayout>
