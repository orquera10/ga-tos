<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vincular con tu Cuenta"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa tus credenciales de gastos.dario10.pw una sola vez para que el Widget de escritorio funcione automáticamente."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Usuario o Email"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAuthUser"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:inputType="textEmailAddress"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contraseña"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAuthPassword"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:inputType="textPassword"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelAuth"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Cancelar"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_secondary"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConnectAuth"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Vincular"
            android:textColor="#000000"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="24dp" />

    </LinearLayout>

</LinearLayout>
