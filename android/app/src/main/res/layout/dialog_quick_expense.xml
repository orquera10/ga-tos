<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CARGA RÁPIDA WIDGET"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar gasto"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ Quedará marcado en la app para que completes categoría, cuenta o etiqueta luego."
        android:textColor="@color/warning"
        android:textSize="11sp"
        android:layout_marginBottom="16dp" />

    <!-- Monto Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monto ($)"
        android:textColor="#D5D6E2"
        android:textStyle="bold"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etMonto"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:inputType="numberDecimal"
        android:hint="0"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp" />

    <!-- Concepto Opcional -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Concepto (opcional)"
        android:textColor="#D5D6E2"
        android:textStyle="bold"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etNombre"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:inputType="textCapSentences"
        android:hint="Vacío = ⚡ Gasto rápido automático"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp" />

    <!-- Presupuesto Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Presupuesto"
        android:textColor="#D5D6E2"
        android:textStyle="bold"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spPresupuesto"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/input_bg"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#D5D6E2"
            android:textStyle="bold"
            app:backgroundTint="#242731"
            app:cornerRadius="13dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.3"
            android:text="Guardar gasto"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="@color/danger"
            app:cornerRadius="13dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</LinearLayout>
