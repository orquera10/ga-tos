<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <!-- Header compacto en 1 fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_icon_rose_bg"
                android:layout_marginEnd="9dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_up"
                    android:contentDescription="Gasto" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gasto rápido"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <Spinner
                android:id="@+id/spPresupuesto"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="120dp"
                android:background="@drawable/input_bg"
                android:popupBackground="#151821"
                android:paddingHorizontal="6dp" />

        </LinearLayout>

        <!-- Monto compacto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/amount_prefix_bg"
                android:text="$"
                android:textColor="#A99FFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMonto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="Monto (0)"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="19sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

        <!-- Concepto compacto -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:inputType="textCapSentences"
            android:imeOptions="actionDone"
            android:hint="Concepto (opcional, ej. Kiosco)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Tags compactos de Medio de pago -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/chipMetodoEfectivo"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="💵 Efectivo"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/chip_method_selected"
                android:singleLine="true"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/chipMetodoTransferencia"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🏦 Transf."
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#A8AAB8"
                android:background="@drawable/chip_method_unselected"
                android:singleLine="true"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/chipMetodoTarjeta"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="💳 Tarjeta"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#A8AAB8"
                android:background="@drawable/chip_method_unselected"
                android:singleLine="true" />

        </LinearLayout>

        <!-- Botones compactos siempre visibles sobre el teclado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#D5D6E2"
                android:textStyle="bold"
                app:backgroundTint="#242731"
                app:cornerRadius="11dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="7dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.4"
                android:text="Guardar gasto"
                android:textSize="13.5sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="@color/danger"
                app:cornerRadius="11dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
