<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp"
    android:background="@drawable/widget_bg">

    <!-- Left: Presupuesto & Saldo -->
    <LinearLayout
        android:id="@+id/widgetBudgetInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widgetBudgetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presupuesto ▾"
            android:textColor="#A99FFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_pill_purple"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widgetTxtRestante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ 0"
            android:textColor="#F4F3FA"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Right: Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/widgetBtnAddExpense"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="80dp"
            android:paddingHorizontal="12dp"
            android:text="↑ Gasto"
            android:textAllCaps="false"
            android:textColor="#FF8780"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_expense"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/widgetBtnAddIncome"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="82dp"
            android:paddingHorizontal="12dp"
            android:text="↓ Ingreso"
            android:textAllCaps="false"
            android:textColor="#55D2AD"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/widgetBtnRefresh"
            android:layout_width="38dp"
            android:layout_height="40dp"
            android:text="↻"
            android:textColor="#B1B2C0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_secondary" />

    </LinearLayout>

</LinearLayout>
