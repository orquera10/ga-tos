<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:background="@drawable/widget_bg">

    <!-- Left: Balance Card (máximo espacio para visualizar el saldo en 1 línea) -->
    <LinearLayout
        android:id="@+id/widgetBudgetInfo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:background="@drawable/widget_balance_card_bg"
        android:layout_marginEnd="5dp">

        <!-- Top row: Balance label + Budget Selector Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo"
                android:textColor="#D9D2FF"
                android:textSize="9.5sp"
                android:layout_marginEnd="6dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widgetBudgetName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Presupuesto ▾"
                android:textColor="#F2EFFF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/widget_period_pill_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                android:singleLine="true"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Bottom row: Main Balance Amount -->
        <TextView
            android:id="@+id/widgetTxtRestante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$ 0"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="13sp"
            android:autoSizeMaxTextSize="20sp" />

    </LinearLayout>

    <!-- Right: Botones compactos solo iconos (Gasto rojo, Ingreso verde, Ver, Actualizar) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Botón Rojo: Gasto (solo icono) -->
        <FrameLayout
            android:id="@+id/widgetBtnAddExpense"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_icon_rose_bg"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_up"
                android:contentDescription="Gasto rápido" />

        </FrameLayout>

        <!-- Botón Verde: Ingreso (solo icono) -->
        <FrameLayout
            android:id="@+id/widgetBtnAddIncome"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_icon_green_bg"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_down"
                android:contentDescription="Ingreso rápido" />

        </FrameLayout>

        <!-- Botón Ver presupuesto (solo icono) -->
        <FrameLayout
            android:id="@+id/widgetBtnOpenBudget"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_action_card_bg"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_open"
                android:contentDescription="Ver presupuesto" />

        </FrameLayout>

        <!-- Botón Actualizar (solo icono) -->
        <FrameLayout
            android:id="@+id/widgetBtnRefresh"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_action_card_bg">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_refresh"
                android:contentDescription="Actualizar saldo" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
