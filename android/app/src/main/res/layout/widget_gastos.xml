<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="7dp"
    android:background="@drawable/widget_bg">

    <!-- Left: Figma Purple Gradient Balance Card -->
    <LinearLayout
        android:id="@+id/widgetBudgetInfo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:background="@drawable/widget_balance_card_bg"
        android:layout_marginEnd="6dp">

        <!-- Top row: Balance label + Budget Selector Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Balance"
                android:textColor="#D9D2FF"
                android:textSize="10sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widgetBudgetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="115dp"
                android:text="Presupuesto ▾"
                android:textColor="#F2EFFF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/widget_period_pill_bg"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:singleLine="true"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Bottom row: Main Balance Amount -->
        <TextView
            android:id="@+id/widgetTxtRestante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$ 0"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="13sp"
            android:autoSizeMaxTextSize="19sp" />

    </LinearLayout>

    <!-- Right: Figma Quick Action Cards (Gasto / Ingreso / Refresh) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Card Button: Gasto -->
        <LinearLayout
            android:id="@+id/widgetBtnAddExpense"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:paddingHorizontal="4dp"
            android:background="@drawable/widget_action_card_bg"
            android:layout_marginEnd="6dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_icon_rose_bg">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_up"
                    android:contentDescription="Gasto" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Gasto"
                android:textColor="#EEEEF6"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />

        </LinearLayout>

        <!-- Card Button: Ingreso -->
        <LinearLayout
            android:id="@+id/widgetBtnAddIncome"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:paddingHorizontal="4dp"
            android:background="@drawable/widget_action_card_bg"
            android:layout_marginEnd="6dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_icon_green_bg">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_down"
                    android:contentDescription="Ingreso" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Ingreso"
                android:textColor="#EEEEF6"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />

        </LinearLayout>

        <!-- Card Button: Refresh -->
        <FrameLayout
            android:id="@+id/widgetBtnRefresh"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_action_card_bg">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_refresh"
                android:contentDescription="Actualizar" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
