<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Sección de Presupuesto y Saldo Restante -->
    <LinearLayout
        android:id="@+id/widgetBudgetInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widgetBudgetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presupuesto ▾"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widgetTxtRestante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ 0.00"
            android:textColor="@color/success"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Botón + Gasto -->
    <Button
        android:id="@+id/widgetBtnAddExpense"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="+ Gasto"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/btn_expense"
        android:paddingHorizontal="10dp"
        android:layout_marginEnd="6dp" />

    <!-- Botón + Ingreso -->
    <Button
        android:id="@+id/widgetBtnAddIncome"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="+ Ingreso"
        android:textColor="#000000"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/btn_primary"
        android:paddingHorizontal="10dp"
        android:layout_marginEnd="6dp" />

    <!-- Botón Refrescar -->
    <Button
        android:id="@+id/widgetBtnRefresh"
        android:layout_width="30dp"
        android:layout_height="32dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="↻"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:background="@drawable/btn_secondary"
        android:padding="0dp" />

</LinearLayout>
